{
  "name": "@janelia-flyem/react-neuroglancer",
  "version": "2.5.1",
  "description": "React component wrapping neuroglancer",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src",
    "LICENESE.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "dev": "vite build --watch",
    "example": "npm run build && vite --config vite.config.example.js",
    "example:build": "npm run build && vite build --config vite.config.example.js",
    "prepublishOnly": "npm run build"
  },
  "author": "Jody Clements",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.2.0",
    "babel-eslint": "^10.1.0",
    "eslint": "^7.7.0",
    "eslint-config-airbnb": "^18.2.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-jsx-a11y": "^6.3.1",
    "eslint-plugin-react": "^7.20.6",
    "jsdom": "^25.0.1",
    "prettier": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.0.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@janelia-flyem/neuroglancer": "^3.0.0-beta.1"
  },
  "peerDependencies": {
    "prop-types": "^15.6.2",
    "react": ">=16.5.2 <19.0.0",
    "react-dom": ">=16.5.2 <19.0.0"
  }
}
